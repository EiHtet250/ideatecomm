# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Base URL of the MINT n8n webhooks (production URL, ends in /webhook/mint, no trailing slash).
VITE_N8N_BASE_URL=https://your-n8n-host.example.com/webhook/mint
#
# Shared key sent as the x-mint-key header. Must match the "MINT - x-mint-key" Header Auth credential in n8n.
# NOTE: VITE_ variables are bundled into the built JavaScript and are visible to anyone.
# This key is only a prototype deterrent, not real security.
VITE_N8N_API_KEY=replace-with-your-key
#
# Base URL of the MINT auth (login / sign-up OTP) n8n webhooks, no trailing slash.
# The app calls {base}/request-otp and {base}/verify-otp.
VITE_AUTH_BASE_URL=https://your-n8n-host.example.com/webhook/mint-auth
