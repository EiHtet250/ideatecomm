      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\n\nconst email = String(body.email ?? '').trim().toLowerCase();\n// Remove control characters, collapse spaces, and keep at most 40 characters.\nconst name = [...String(body.name ?? '')\n  .replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()].slice(0, 40).join('');\n\nlet error = null;\n\nif (!/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@gmail\\.com$/.test(email)) {\n  error = 'Please enter a valid @gmail.com address.';\n} else if (!name) {\n  error = 'Please enter a name.';\n}\n\nreturn [{\n  json: {\n    valid: error === null,\n    email,\n    name,\n    error\n  }\n}];"
      },
