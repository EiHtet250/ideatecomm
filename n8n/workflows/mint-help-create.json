      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "\n// Strip control characters. Descriptions keep single line breaks.\nconst cleanLine = (v) => typeof v === 'string' ? v.replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, ' ').replace(/\\s+/g, ' ').trim() : '';\nconst cleanText = (v) => typeof v === 'string'\n  ? v.replace(/\\r\\n?/g, '\\n').replace(/[\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F]/g, '').replace(/\\n{3,}/g, '\\n\\n').trim()\n  : '';\nconst len = (s) => [...s].length; // count characters, not UTF-16 units\nconst fail = (message) => [{ json: { valid: false, error: { code: 'VALIDATION', message } } }];\nconst raw = $input.first().json.body;\nconst body = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};\n\nconst AREA_SOURCES = ['manual', 'lastScanned'];\nconst area = cleanLine(body.area);\nconst description = cleanText(body.description);\nconst areaSource = body.areaSource;\n\nif (!area) return fail('Please choose the area where you are.');\nif (len(area) > 100) return fail('The area is too long. Please use 100 characters or fewer.');\nif (!AREA_SOURCES.includes(areaSource)) return fail('The area type is not valid. Please choose the area again.');\nif (!description) return fail('Please tell us what help you need.');\nif (len(description) > 500) return fail('Your message is too long. Please use 500 characters or fewer.');\n\nreturn [{ json: { valid: true, area, areaSource, description } }];"
      },
      "onError": "continueErrorOutput"
    },
