      "parameters": {
        "jsCode": "const STATUSES = ['new', 'in_progress', 'resolved', 'cancelled', 'not_found'];\nconst fail = (message) => [{ json: { valid: false, error: { code: 'VALIDATION', message } } }];\nconst query = $input.first().json.query || {};\n\nconst status = typeof query.status === 'string' ? query.status.trim() : '';\nif (status && !STATUSES.includes(status)) {\n  return fail('That status filter is not valid. Use new, in_progress, resolved, cancelled or not_found.');\n}\n\n// Optional: one request by its number (the visitor's Help page follows its own request).\nconst idRaw = typeof query.id === 'string' ? query.id.trim() : '';\nconst id = idRaw ? Number(idRaw) : 0;\nif (idRaw && (!Number.isInteger(id) || id <= 0)) return fail('The request number is not valid.');\n\nreturn [{ json: { valid: true, status, id } }];"
      },
