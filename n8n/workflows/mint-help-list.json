      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const STATUSES = ['new', 'in_progress', 'resolved'];\nconst query = $input.first().json.query || {};\nconst status = typeof query.status === 'string' ? query.status.trim() : '';\nif (status && !STATUSES.includes(status)) {\n  return [{ json: { valid: false, error: { code: 'VALIDATION', message: 'That status filter is not valid. Use new, in_progress or resolved.' } } }];\n}\nreturn [{ json: { valid: true, status } }];"
      },
      "onError": "continueErrorOutput"
    },
