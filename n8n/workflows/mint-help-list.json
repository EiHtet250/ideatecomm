            "version": 2
          },
          "conditions": [
            {
              "id": "f0fdde0b-d269-47f3-aa03-53834dfcb284",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
