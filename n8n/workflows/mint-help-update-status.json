      "parameters": {
        "jsCode": "\n// Strip control characters. Descriptions keep single line breaks.\nconst cleanLine = (v) => typeof v === 'string' ? v.replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, ' ').replace(/\\s+/g, ' ').trim() : '';\nconst cleanText = (v) => typeof v === 'string'\n  ? v.replace(/\\r\\n?/g, '\\n').replace(/[\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F]/g, '').replace(/\\n{3,}/g, '\\n\\n').trim()\n  : '';\nconst len = (s) => [...s].length; // count characters, not UTF-16 units\nconst fail = (message) => [{ json: { valid: false, error: { code: 'VALIDATION', message } } }];\nconst raw = $input.first().json.body;\nconst body = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};\n\n// cancelled: the visitor no longer needs help. not_found: staff could not find the visitor.\nconst STATUSES = ['new', 'in_progress', 'resolved', 'cancelled', 'not_found'];\nconst idRaw = typeof body.id === 'string' ? body.id.trim() : body.id;\nconst id = Number(idRaw);\nif (idRaw === undefined || idRaw === null || idRaw === '' || !Number.isInteger(id) || id <= 0) {\n  return fail('The request number is missing or not valid.');\n}\nif (!STATUSES.includes(body.status)) return fail('The status is not valid. Use new, in_progress, resolved, cancelled or not_found.');\nreturn [{ json: { valid: true, id, status: body.status } }];"
      },
