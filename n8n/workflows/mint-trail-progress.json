    {
      "parameters": {
        "jsCode": "// Discovery Trail spots in play order. Keep in step with src/data/trail/discoveryTrail.ts.\nconst SPOTS = [\n  {\n    \"id\": \"spot-rocket\",\n    \"qrCode\": \"MINT-TRAIL-ROCKET\",\n    \"stampId\": \"stamp-rocket\",\n    \"order\": 1\n  },\n  {\n    \"id\": \"spot-robot\",\n    \"qrCode\": \"MINT-TRAIL-ROBOT\",\n    \"stampId\": \"stamp-robot\",\n    \"order\": 2\n  },\n  {\n    \"id\": \"spot-spinning-top\",\n    \"qrCode\": \"MINT-TRAIL-TOP\",\n    \"stampId\": \"stamp-spinning-top\",\n    \"order\": 3\n  }\n];\n\nconst body = $input.first().json.body ?? {};\nconst action = String(body.action ?? '');\nconst email = String(body.email ?? '').trim().toLowerCase();\nconst spotId = String(body.spotId ?? '').trim();\nconst qrCode = String(body.qrCode ?? '').trim().toUpperCase();\n\nlet error = null;\nlet spot = null;\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || email.length > 254) {\n  error = 'A valid email is required.';\n} else if (!['list', 'complete'].includes(action)) {\n  error = 'Unknown action.';\n} else if (action === 'complete') {\n  spot = SPOTS.find((item) => item.id === spotId) ?? null;\n  if (!spot) error = 'Unknown discovery spot.';\n  else if (spot.qrCode.toUpperCase() !== qrCode) error = 'That QR code does not match this discovery spot.';\n}\n\nreturn [{\n  json: {\n    valid: error === null,\n    error,\n    action,\n    email,\n    spotId: spot ? spot.id : '',\n    stampId: spot ? spot.stampId : '',\n    order: spot ? spot.order : 0,\n    earlierSpotIds: spot ? SPOTS.filter((item) => item.order < spot.order).map((item) => item.id) : []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "8d5fd6e4-5497-4244-97a0-d80d716d7a70",
