      "id": "e9606404-28c8-461b-9914-a448dfccd57e",
      "name": "Find Visitor Stamps",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const request = $('Validate Request').first().json;\nconst have = [...new Set(\n  $input.all().map((item) => item.json.spotId).filter((id) => typeof id === 'string' && id)\n)];\n\nlet mode = 'list';\nlet message = '';\n\nif (request.action === 'complete') {\n  if (have.includes(request.spotId)) {\n    // Already saved: never store or reward the same stamp twice.\n    mode = 'already';\n  } else if (request.earlierSpotIds.some((id) => !have.includes(id))) {\n    mode = 'locked';\n    message = 'Earlier discovery spots must be completed first.';\n  } else {\n    mode = 'insert';\n  }\n}\n\nreturn [{\n  json: {\n    mode,\n    insert: mode === 'insert',\n    locked: mode === 'locked',\n    message,\n    email: request.email,\n    spotId: request.spotId,\n    stampId: request.stampId,\n    spotIds: mode === 'insert' ? [...have, request.spotId] : have\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
