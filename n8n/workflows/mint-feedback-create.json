      "parameters": {
        "jsCode": "\n// Strip control characters. Descriptions keep single line breaks.\nconst cleanLine = (v) => typeof v === 'string' ? v.replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, ' ').replace(/\\s+/g, ' ').trim() : '';\nconst cleanText = (v) => typeof v === 'string'\n  ? v.replace(/\\r\\n?/g, '\\n').replace(/[\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F]/g, '').replace(/\\n{3,}/g, '\\n\\n').trim()\n  : '';\nconst len = (s) => [...s].length; // count characters, not UTF-16 units\nconst fail = (message) => [{ json: { valid: false, error: { code: 'VALIDATION', message } } }];\nconst raw = $input.first().json.body;\nconst body = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};\n\nconst rating = typeof body.rating === 'string' ? Number(body.rating.trim()) : body.rating;\nconst comment = cleanText(body.comment);\n\nif (rating === undefined || rating === null || rating === '') return fail('Please choose how easy the guide was to use.');\nif (!Number.isInteger(rating) || rating < 1 || rating > 5) return fail('Please choose a rating from 1 to 5.');\nif (len(comment) > 500) return fail('Your comment is too long. Please use 500 characters or fewer.');\n\nreturn [{ json: { valid: true, rating, comment } }];"
      },
      "onError": "continueErrorOutput"
    },
