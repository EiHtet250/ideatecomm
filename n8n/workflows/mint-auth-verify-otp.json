    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\n\nconst email = String(body.email ?? '').trim().toLowerCase();\nconst challengeId = String(body.challengeId ?? '').trim();\nconst otp = String(body.otp ?? '').trim();\n\nlet error = null;\n\nif (!/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@gmail\\.com$/.test(email)) {\n  error = 'Please enter a valid @gmail.com address.';\n} else if (!/^[a-f0-9]{64}$/.test(challengeId)) {\n  error = 'This code request is not valid. Please request a new code.';\n} else if (!/^[0-9]{6}$/.test(otp)) {\n  error = 'Please enter the 6-digit code.';\n}\n\nreturn [{\n  json: {\n    valid: error === null,\n    email,\n    challengeId,\n    otp,\n    error\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
