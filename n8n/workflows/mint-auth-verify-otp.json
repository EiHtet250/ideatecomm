      "id": "ded4deba-e2f7-435d-9b29-ebc687699541",
      "name": "Find OTP Request",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst request = $('Validate Input').first().json;\nconst row = $input.first().json ?? {};\nconst MAX_ATTEMPTS = 5;\n\nconst attempts = Number(row.attempts ?? 0);\nlet result = 'ok';\nlet message = '';\n\nif (!row.challengeId || row.email !== request.email) {\n  result = 'not_found';\n  message = 'This code is not valid. Please request a new code.';\n} else if (row.used === true) {\n  result = 'used';\n  message = 'This code has already been used. Please request a new code.';\n} else if (!(new Date(row.expiresAt).getTime() > Date.now())) {\n  result = 'expired';\n  message = 'This code has expired. Please request a new code.';\n} else if (attempts >= MAX_ATTEMPTS) {\n  result = 'locked';\n  message = 'Too many wrong attempts. Please request a new code.';\n} else {\n  const expected = Buffer.from(String(row.otpHash ?? ''), 'hex');\n  const actual = crypto.scryptSync(request.otp, row.challengeId, 32);\n  const matches = expected.length === actual.length\n    && crypto.timingSafeEqual(expected, actual);\n  if (!matches) {\n    result = 'wrong';\n    message = 'That code is not correct. Please try again.';\n  }\n}\n\nreturn [{\n  json: {\n    result,\n    correct: result === 'ok',\n    wrong: result === 'wrong',\n    message,\n    rowId: row.id ?? null,\n    nextAttempts: attempts + 1,\n    email: request.email,\n    purpose: String(row.purpose ?? ''),\n    pendingName: String(row.pendingName ?? '')\n  }\n}];"
      },
